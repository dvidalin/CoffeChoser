# Copy to .env.local and fill in from Firebase console → Project settings → Your apps → Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional, comma-separated. Only these Google accounts can use the app (UI check).
# Real enforcement lives in firestore.rules — keep both lists in sync.
VITE_ALLOWED_EMAILS=
